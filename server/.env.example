# server/.env 로 복사 후 값 입력
GEMINI_API_KEY=AIzaYOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash
PORT=8787
APP_BASE_URL=http://127.0.0.1:8787

# 로컬 개발용 (확장 config.js API_DEV_SECRET 과 동일하게)
# 설정 시 로그인 없이 AI 호출 가능 (한도·구독 없음)
# DEV_API_SECRET=dev-change-me

# 계정·구독 (Phase 2)
# ALLOW_REGISTRATION=true
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=change-me-8chars
# ADMIN_SECRET=admin-change-me
# 관리자 페이지: https://your-app.up.railway.app/admin.html
# SESSION_DAYS=30

# 카카오 로그인
# KAKAO_REST_API_KEY=your_kakao_rest_api_key
# KAKAO_CLIENT_SECRET=your_kakao_client_secret
# KAKAO_REDIRECT_URI=http://127.0.0.1:8787/api/auth/kakao/callback

# 결제·구독 (Phase 3)
# 로그인 계정은 구독 전에도 답글 20건·말투 1회를 평생 한 번 무료 체험합니다.
#
# --- 로컬 테스트 (카드 없음) ---
# BILLING_MOCK=true
#
# --- Railway 토스 연결 (권장: 먼저 테스트 키) ---
# 1) https://developers.tosspayments.com/ 에서 자동결제(빌링) 키 발급
# 2) .\scripts\enable-toss-billing.ps1  또는 Railway Variables에 직접 입력
# BILLING_MOCK=false
# TOSS_CLIENT_KEY=test_ck_...
# TOSS_SECRET_KEY=test_sk_...
# APP_BASE_URL=https://naver-smartstore-review-reply-production.up.railway.app
# DATA_DIR=/data
# 3) .\scripts\verify-billing-ready.ps1 로 health.productionReady=true 확인
#
# SUBSCRIPTION_DAYS=30
# RENEWAL_ENABLED=true
# RENEWAL_INTERVAL_MS=900000
# RENEWAL_GRACE_DAYS=3
# RENEWAL_MAX_ATTEMPTS=3
