{
  "manifest_version": 3,
  "name": "스마트스토어 AI 자동답글",
  "version": "1.3.67",
  "description": "기존 답글 자동 분석 기반 · 리뷰·문의 수집부터 AI 답글 작성까지",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "tabs", "scripting", "notifications", "sidePanel"],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://sell.smartstore.naver.com/*",
    "http://127.0.0.1:8787/*",
    "http://localhost:8787/*",
    "https://*.up.railway.app/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "action": {
    "default_title": "스마트스토어 AI 자동답글",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "externally_connectable": {
    "matches": [
      "https://*.up.railway.app/*",
      "http://127.0.0.1:8787/*",
      "http://localhost:8787/*"
    ]
  },
  "content_scripts": [
    {
      "matches": ["https://sell.smartstore.naver.com/*"],
      "js": [
        "config.js",
        "lib/lookup-days.js",
        "content-import.js",
        "content-submit.js",
        "content-inquiry-import.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": ["https://sell.smartstore.naver.com/*"],
      "js": [
        "config.js",
        "content.js",
        "content-inquiry-fill.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page-hook.js"],
      "matches": ["https://sell.smartstore.naver.com/*"]
    }
  ]
}
